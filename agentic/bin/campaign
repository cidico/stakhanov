#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"
# shellcheck source=../lib/validation.sh
source "$SCRIPT_DIR/../lib/validation.sh"
# shellcheck source=../lib/slots.sh
source "$SCRIPT_DIR/../lib/slots.sh"
# shellcheck source=../lib/plan.sh
source "$SCRIPT_DIR/../lib/plan.sh"
# shellcheck source=../lib/provider.sh
source "$SCRIPT_DIR/../lib/provider.sh"
# shellcheck source=../lib/engine.sh
source "$SCRIPT_DIR/../lib/engine.sh"
# shellcheck source=../lib/control.sh
source "$SCRIPT_DIR/../lib/control.sh"
# shellcheck source=../lib/finalize.sh
source "$SCRIPT_DIR/../lib/finalize.sh"
# shellcheck source=../lib/queue.sh
source "$SCRIPT_DIR/../lib/queue.sh"
# shellcheck source=../lib/overview.sh
source "$SCRIPT_DIR/../lib/overview.sh"
# shellcheck source=../lib/guards.sh
source "$SCRIPT_DIR/../lib/guards.sh"
# shellcheck source=../lib/machine.sh
source "$SCRIPT_DIR/../lib/machine.sh"
# shellcheck source=../lib/task.sh
source "$SCRIPT_DIR/../lib/task.sh"

usage() {
  cat <<'EOF'
Usage: campaign <command> [options]

Commands:
  init [SPEC] [--slug SLUG]       Create campaign branch, worktree and canonical SPEC
  current [--json]                Print campaign inferred from the current branch
  verify                          Validate SPEC, tickets and dependency graph
  status [--json]                 Show ticket and runner state
  ready [--json]                  Show READY tickets (todo with done dependencies)
  run --provider NAME [options]   Run or attach to a campaign
  stop [--now]                    Start no new ticket and stop when the running ones end (--now: stop at once)
  restart [--now] [options]       Stop (at once with --now), then run again with the last run's settings
  move --to MACHINE [--now] [--start|--no-start]
                                  Move the campaign to another machine of the fleet, with its uncommitted work
  watch [campaign-watch options]  Wait until the campaign needs its coordinator (campaign-watch)
  decide TICKET DECISION          Resolve a pending retry/block/cancel decision
  recover TICKET                 Reuse existing delta for validation and fresh review
  finalize                        Gate, clean, rebase and FF-only merge into the main branch
  finalizing                      List the finalizes validating on this machine (exit 0), or none (exit 1)
  cleanup [--ticket ID]           Remove runner-owned completed/stale resources
  self-test                       Run deterministic harness tests with mock providers
  queue start FILE [--foreground] Run campaigns in sequence (init → run → finalize), resumable
  queue status [NAME] [--json]    Show queue progress
  queue stop NAME                 Stop a queue supervisor (runners keep going)
  overview [--json] [--fleet]     Every campaign and queue in the cache, for the status skill (--fleet: on every
                                  machine of the project's fleet)
  guards [--json]                 The reviewer findings that an automatic check (analyzer, lint, test, validate, executor)
                                  could have caught, in every campaign and task of this machine
  machine [--fleet] [--json]      This machine's free slots, load, accounts and proven capabilities (--fleet: every
                                  machine of the project's fleet)
  fleet [--json]                  The machines of the project's fleet, and how their main branches compare
  fleet join NAME --ssh DEST      Add a machine to the fleet, cloning the project there
        [--path PATH] [--as NAME] [--as-ssh DEST]
  fleet leave NAME                Remove a machine from the fleet
  task <command> NAME [options]   A task on this machine: new, list, status, log, diff, stop, restart, fix, accept,
                                  drop (campaign task --help)

Run options: --mode interactive|unattended, --workers 1..3 (default 2)

status, stop, run, restart, decide, recover, watch and move also take --campaign SLUG [--on MACHINE]: they then act
on that campaign wherever it is in the project's fleet (on MACHINE when given), from any worktree. finalize --campaign
SLUG first moves the campaign to this machine, then finalizes it into this machine's main branch.
EOF
}

# The fleet's functions (lib/fleet.sh, over the ssh transport of lib/remote.sh), loaded by the commands that use them.
fleet_lib() {
  # shellcheck source=../lib/remote.sh
  source "$AGENTIC_DIR/lib/remote.sh"
  # shellcheck source=../lib/fleet.sh
  source "$AGENTIC_DIR/lib/fleet.sh"
  # shellcheck source=../lib/move.sh
  source "$AGENTIC_DIR/lib/move.sh"
}

cmd_self_test() {
  local test_file="$AGENTIC_DIR/tests/test_campaign.py"
  [[ -f $test_file ]] || die "self-test unavailable: $test_file; the kit's tests are not installed in projects, run the self-test from the stakhanov repository (agentic/bin/campaign self-test in a clone of https://github.com/cidico/stakhanov, or its agentic/tests)"
  python3 -m unittest discover -s "$AGENTIC_DIR/tests" -p 'test_*.py'
  bash "$AGENTIC_DIR/tests/provider-adapters.sh"
}

command=${1:-}; (($#)) && shift
# --campaign SLUG [--on MACHINE]: the command acts on that campaign wherever it is in the fleet.
case "$command" in
  status | stop | run | restart | decide | recover | watch | move | finalize)
    route_slug='' route_machine=''
    route_args=()
    while (($#)); do
      case $1 in
        --campaign) (($# >= 2)) || die '--campaign requires a slug'; route_slug=$2; shift 2 ;;
        --on) (($# >= 2)) || die '--on requires a machine'; route_machine=$2; shift 2 ;;
        *) route_args+=("$1"); shift ;;
      esac
    done
    [[ -n $route_slug || -z $route_machine ]] || die '--on needs --campaign SLUG'
    if [[ -n $route_slug ]]; then
      fleet_lib
      [[ $command != finalize ]] || finalize_here "$route_slug" "$route_machine" "${route_args[@]}"
      route_campaign "$route_slug" "$route_machine" "$command" "${route_args[@]}"
    fi
    set -- "${route_args[@]}"
    ;;
esac
case "$command" in
  init) cmd_init "$@" ;;
  current) cmd_current "$@" ;;
  verify) cmd_verify "$@" ;;
  status) cmd_status "$@" ;;
  ready) cmd_ready "$@" ;;
  run) cmd_run "$@" ;;
  stop) cmd_stop "$@" ;;
  restart) cmd_restart "$@" ;;
  move) fleet_lib; cmd_move "$@" ;;
  _adopt) fleet_lib; cmd_adopt "$@" ;;
  watch) cmd_watch "$@" ;;
  decide) cmd_decide "$@" ;;
  recover) cmd_recover "$@" ;;
  finalize) cmd_finalize "$@" ;;
  finalizing) cmd_finalizing "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  self-test) cmd_self_test "$@" ;;
  queue) cmd_queue "$@" ;;
  overview) cmd_overview "$@" ;;
  guards) cmd_guards "$@" ;;
  machine) cmd_machine "$@" ;;
  fleet) fleet_lib; cmd_fleet "$@" ;;
  _queue) queue_loop "$@" ;;
  _supervise) supervise_loop "$@" ;;
  _engine) (($# == 2)) || die 'invalid engine invocation'; engine_loop "$1" "$2" ;;
  _task-plan) cmd_task_plan "$@" ;;
  task) cmd_task "$@" ;;
  _verify-rebase) (($# == 4)) || die 'usage: _verify-rebase WORKTREE OLD_TIP OLD_BASE UPSTREAM'; verify_rebase_kept_changes "$@" ;;
  help|-h|--help|'') usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
